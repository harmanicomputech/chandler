# ── Core ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/chandler
DATABASE_POOL_MAX=10
VISIT_SITE_URL=https://www.visitchandler.com
EDO_SITE_URL=https://business.chandleraz.gov            # proposed host — City to confirm
EDO_HOSTS=business.chandleraz.gov                         # comma-separated hosts served by the EDO site
NEXT_PUBLIC_EDO_BASE_PATH=                                # '' when EDO has its own host; '/edo' on a shared host
ALLOW_INDEXING=false                                      # 'true' only on production
RATE_LIMIT_SALT=change-me                                 # random string; IPs are hashed with it
LOGIN_RATE_LIMIT=10                                       # sign-in attempts per IP per 10 minutes

# ── Weather ───────────────────────────────────────────────────────────
NWS_USER_AGENT="VisitChandlerWeather/1.0 (tourism@chandleraz.gov)"   # NWS asks for a contact in the User-Agent
WEATHER_UV_PROVIDER=open-meteo                            # 'none' to disable UV lookup

# ── Maps ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_TILE_URL=                                 # default CARTO Voyager; set City ArcGIS / Mapbox tile URL when licensed
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ── Analytics (loaded only after visitor consent) ─────────────────────
NEXT_PUBLIC_GTM_ID_VISIT=
NEXT_PUBLIC_GTM_ID_EDO=

# ── Integrations (inactive until set) ─────────────────────────────────
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
NEWSLETTER_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
STAFF_NOTIFY_TO=

# ── AI concierge (Anthropic) ──────────────────────────────────────────
ANTHROPIC_API_KEY=                                        # blank → concierge runs in retrieval-only mode
CONCIERGE_MODEL=claude-opus-5-5
CONCIERGE_MODE=                                           # 'retrieval' to force non-AI mode

# ── Seeding (development only) ────────────────────────────────────────
SEED_PASSWORD=
